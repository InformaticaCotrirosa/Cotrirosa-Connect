{
  "name": "MeetingRoom",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da sala"
    },
    "type": {
      "type": "string",
      "enum": [
        "carro",
        "sala_reuniao"
      ],
      "default": "sala_reuniao",
      "description": "Tipo (Carro ou Sala de reuni\u00e3o)"
    },
    "unit": {
      "type": "string",
      "enum": [
        "agronegocio",
        "supermercados",
        "lojas_agropecuarias",
        "fabrica_racao",
        "centro_distribuicao",
        "administrativo"
      ],
      "description": "Unidade"
    },
    "capacity": {
      "type": "number",
      "description": "Capacidade de pessoas"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recursos dispon\u00edveis (projetor, videoconfer\u00eancia, etc.)"
    },
    "color": {
      "type": "string",
      "default": "#22c55e",
      "description": "Cor de identifica\u00e7\u00e3o da sala"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o (arrast\u00e1vel pelo admin)"
    }
  },
  "required": [
    "name",
    "unit",
    "capacity"
  ]
}