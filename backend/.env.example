# Server — portas exclusivas do Cotrirosa-Connect
# Backend 3010 | Frontend 5174 (não usar 3001/5173 — conflito com outros apps)
PORT=3010
NODE_ENV=development
# Origens CORS (LAN + localhost), separadas por vírgula
FRONTEND_URL=http://192.168.0.132:5174,http://localhost:5174,http://127.0.0.1:5174

# Oracle Database
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_SCHEMA=seu_schema
ORACLE_CONNECTION_STRING=PROD
# Ajuste os caminhos absolutos na sua máquina
TNS_ADMIN=./backend/oracle/network/admin
ORACLE_CLIENT_LIB=./backend/oracle/instantclient_23_4
# Alternativa Easy Connect: host:1526/SERVICE_NAME
# Windows:
# TNS_ADMIN=C:\app\client\product\19.0.0\client_64\network\admin
# ORACLE_CLIENT_LIB=C:\app\client\product\19.0.0\client_64\bin

# JWT
JWT_SECRET=altere_esta_chave_secreta
JWT_EXPIRES_IN=24h

# Email (para notificações)
SMTP_HOST=seu_smtp_host
SMTP_PORT=587
SMTP_USER=seu_email
SMTP_PASSWORD=sua_senha
SMTP_FROM=noreply@exemplo.com

# Google OAuth
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# Autenticação Senior (AuthenticateJAAS)
EXTERNAL_AUTH_URL=http://seu-servidor/g5-senior-services/sapiens_SyncMCWFUsers
EXTERNAL_AUTH_SERVICE_USER=seu_usuario_servico
EXTERNAL_AUTH_SERVICE_PASSWORD=sua_senha_servico
